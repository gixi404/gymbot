# ==============================================================================
# CONFIGURACIÓN DE GYMBOT - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env` y completa tus credenciales reales:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TELEGRAM MTPROTO (LECTURA PASIVA DE ENTRENAMIENTOS)
# ------------------------------------------------------------------------------
# Obtén tu API ID y API HASH en https://my.telegram.org (sección "API development tools")
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789

# Nombre base del archivo de sesión (generará gymbot_user.session)
TELEGRAM_SESSION_NAME=gymbot_user

# Identificador del chat privado o canal donde anotas tus entrenamientos
# Puede ser el ID numérico (ej. -1001234567890) o el username (ej. @mis_entrenos_privado)
TELEGRAM_WORKOUT_CHAT_ID=-1001234567890


# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT API (INTERFAZ MÓVIL SECUNDARIA PARA CONSULTAS)
# ------------------------------------------------------------------------------
# Token del bot exclusivo para consultas (créalo hablando con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_12345678

# WHITELIST ESTRICTA: Tu ID de usuario de Telegram (número entero).
# Los mensajes de cualquier otro ID serán completamente ignorados por seguridad.
# Puedes ver tu ID ejecutando `python auth_telethon.py` o enviando un mensaje a @userinfobot
# Para múltiples usuarios autorizados, separa por comas: 123456789,987654321
ALLOWED_TELEGRAM_USER_IDS=123456789


# ------------------------------------------------------------------------------
# 3a. GROQ (PROVEEDOR PRINCIPAL DE TEXTO Y AUDIO - API OpenAI-compatible)
# ------------------------------------------------------------------------------
# Clave gratuita en https://console.groq.com/keys (no requiere tarjeta).
GROQ_API_KEY=gsk_TuClaveGroqAqui

# Endpoint compatible con OpenAI (no cambiar salvo migración de proveedor)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelo diminuto (router) que decide complejidad/grupos/ventana antes de consultar SQLite
GROQ_CLASSIFIER_MODEL=qwen/qwen3.8-27b

# Modelo Groq para consultas simples (respuesta rápida, sin congestión)
GROQ_LIGHT_MODEL=qwen/qwen3.8-27b

# Modelos secundarios de Groq. VACÍO por defecto: si GROQ_LIGHT_MODEL falla, se salta
# directo a DeepSeek. Añade IDs separados por comas solo si quieres otros reintentos en Groq.
GROQ_FALLBACK_MODELS=

# Modelo de transcripción de notas de voz
GROQ_AUDIO_MODEL=whisper-large-v3

# Tope de tokens de salida por respuesta (protege el límite de 8.000 TPM del free tier)
GROQ_MAX_OUTPUT_TOKENS=1024


# ------------------------------------------------------------------------------
# 3b. DEEPSEEK (ANÁLISIS COMPLEJO Y RESPALDO DE GROQ - API OpenAI-compatible)
# ------------------------------------------------------------------------------
# Clave en https://platform.deepseek.com/api_keys. Si se deja vacía, las consultas
# complejas caen al modelo ligero de Groq y luego a Gemini.
DEEPSEEK_API_KEY=

# Endpoint y modelo (no cambiar salvo migración de proveedor)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=2048


# ------------------------------------------------------------------------------
# 3c. ENRUTADOR (NIVELES 1 Y 3)
# ------------------------------------------------------------------------------
# Por encima de este número estimado de tokens (chars/3.8) una consulta "simple"
# deja Groq y pasa a DeepSeek (protege el límite gratuito de ~6.000 TPM de Groq)
ROUTER_TOKEN_THRESHOLD=4200

# Cruce de 2 o más grupos en una ventana mayor a estos días siempre usa DeepSeek
ROUTER_MULTI_GROUP_DAYS=14

# Mapa de grupos lógicos -> chats reales (IDs numéricos o títulos alternativos).
# Necesario porque los mensajes antiguos guardados en la BD no tienen chat_title
# y los grupos físicos no se llaman igual que los lógicos (ej. "GYM" = Sesiones).
# Formato JSON, por ejemplo:
# GROUP_CHAT_MAP={"Sesiones":["-5000217070","GYM","-1004344988533"],"PesoCorporal":["-5397846915"]}
GROUP_CHAT_MAP={"Sesiones":["-5000217070","GYM","-1004344988533"],"Cardio":["-5409553383"],"Comidas":["-5335679250"],"PesoCorporal":["-5397846915"]}


# ------------------------------------------------------------------------------
# 3b. GOOGLE GEMINI (VISIÓN Y RESPALDO)
# ------------------------------------------------------------------------------
# Se usa para analizar fotos/documentos (Groq no tiene visión) y como respaldo si Groq falla.
# Obtén tu clave gratuita en Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyD-TuClaveGeminiAqui1234567890

# Modelo oficial bajo Free Tier (costo $0)
GEMINI_MODEL=gemini-flash-lite-latest


# ------------------------------------------------------------------------------
# 4. PERSISTENCIA LOCAL Y SINCRONIZACIÓN
# ------------------------------------------------------------------------------
# Ruta del archivo SQLite local
DATABASE_PATH=gymbot.db

# Intervalo en minutos para la sincronización pasiva periódica en segundo plano
# (Usa 60 para cada hora, o 0 para sincronizar únicamente bajo demanda con /sync o :sync)
AUTO_SYNC_INTERVAL_MINUTES=60
